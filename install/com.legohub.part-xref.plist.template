<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.legohub.part-xref</string>
    <key>ProgramArguments</key>
    <array>
        <string>@INSTALL_DIR@/.venv/bin/part-xref</string>
    </array>
    <key>WorkingDirectory</key>
    <string>@INSTALL_DIR@</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@INSTALL_DIR@/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@LOG_DIR@/part-xref.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/part-xref.err.log</string>
</dict>
</plist>
